"""Typed structured query builders; expression construction does no document work."""

import builtins
from typing import Generic, Literal, Never, Self, TypeAlias, TypeVar

from . import Change, SemanticAttribute, SemanticOperation, SemanticType, SemanticValue

_T = TypeVar("_T")

class QueryExpr(Generic[_T]):
    def __bool__(self) -> Never: ...

class Predicate:
    def __and__(self, other: Predicate) -> Predicate: ...
    def __or__(self, other: Predicate) -> Predicate: ...
    def __invert__(self) -> Predicate: ...
    def __bool__(self) -> Never: ...

class ChangePredicate:
    def __and__(self, other: ChangePredicate | Predicate) -> ChangePredicate: ...
    def __or__(self, other: ChangePredicate | Predicate) -> ChangePredicate: ...
    def __invert__(self) -> ChangePredicate: ...
    def __bool__(self) -> Never: ...

class ChangeQuery(QueryExpr[list[Change]]):
    def filter(self, predicate: ChangePredicate | Predicate) -> ChangeQuery: ...
    def before(self) -> DiffOpQuery: ...
    def after(self) -> DiffOpQuery: ...
    def unique(self) -> ChangeQuery: ...
    def reverse(self) -> ChangeQuery: ...
    def head(self, count: int) -> ChangeQuery: ...
    def tail(self, count: int) -> ChangeQuery: ...
    def names(self) -> DiffStringQuery: ...
    def attr(self, name: str) -> DiffStringQuery: ...
    def result_types(self) -> DiffStringQuery: ...
    def operand_types(self) -> DiffStringQuery: ...
    def count(self) -> DiffCountQuery: ...

class DiffOpQuery(QueryExpr[list[SemanticOperation]]):
    def filter(self, predicate: Predicate) -> DiffOpQuery: ...
    def users(self, index: int | None = None) -> DiffOpQuery: ...
    def defs(self, index: int | None = None) -> DiffOpQuery: ...
    def parent(self) -> DiffOpQuery: ...
    def children(self) -> DiffOpQuery: ...
    def root(self, predicate: Predicate) -> DiffOpQuery: ...
    def subtree(self) -> DiffOpQuery: ...
    def reachable(self) -> DiffOpQuery: ...
    def closure(self) -> DiffOpQuery: ...
    def slice(self) -> DiffOpQuery: ...
    def backward_slice(self) -> DiffOpQuery: ...
    def forward_slice(self) -> DiffOpQuery: ...
    def fixpoint(self, body: DiffOpQuery) -> DiffOpQuery: ...
    def unique(self) -> DiffOpQuery: ...
    def reverse(self) -> DiffOpQuery: ...
    def head(self, count: int) -> DiffOpQuery: ...
    def tail(self, count: int) -> DiffOpQuery: ...
    def names(self) -> DiffStringQuery: ...
    def attr(self, name: str) -> DiffStringQuery: ...
    def result_types(self) -> DiffStringQuery: ...
    def operand_types(self) -> DiffStringQuery: ...
    def count(self) -> DiffCountQuery: ...

class DiffStringQuery(QueryExpr[list[str]]):
    def sort(self) -> DiffStringQuery: ...
    def min(self) -> DiffStringQuery: ...
    def min_all(self) -> DiffStringQuery: ...
    def max(self) -> DiffStringQuery: ...
    def max_all(self) -> DiffStringQuery: ...
    def unique(self) -> DiffStringQuery: ...
    def reverse(self) -> DiffStringQuery: ...
    def head(self, count: int) -> DiffStringQuery: ...
    def tail(self, count: int) -> DiffStringQuery: ...
    def count(self) -> DiffCountQuery: ...

class DiffCountQuery(QueryExpr[int]): ...

class OpQuery(QueryExpr[list[SemanticOperation]]):
    def operand(self, index: int) -> SsaQuery: ...
    def project(self, subject: str, fields: dict[str, ReportInput]) -> ReportQuery: ...
    def unique(self) -> Self: ...
    def tally(self) -> MapQuery[object]: ...
    def reverse(self) -> Self: ...
    def count(self) -> CountQuery: ...
    def head(self, count: int) -> Self: ...
    def tail(self, count: int) -> Self: ...
    def parent(self) -> OpQuery: ...
    def children(self) -> OpQuery: ...
    def subtree(self) -> OpQuery: ...
    def closure(self) -> OpQuery: ...
    def slice(self) -> OpQuery:
        """Follow transitive SSA definitions; evaluation terminates on cycles."""
    def backward_slice(self) -> OpQuery:
        """Explicit alias for slice()."""
    def forward_slice(self) -> OpQuery:
        """Follow transitive SSA users; evaluation terminates on cycles."""
    def reachable(self) -> OpQuery: ...
    def filter(self, predicate: Predicate) -> OpQuery: ...
    def root(self, predicate: Predicate) -> OpQuery: ...
    def defs(self, index: int | None = None) -> OpQuery: ...
    def paths(
        self, edge: Literal["users"], *, to: Predicate, max_depth: int
    ) -> CaptureQuery: ...
    def users(self, index: int | None = None) -> OpQuery: ...
    def where_exists(self, query: OpQuery) -> OpQuery: ...
    def fixpoint(self, query: OpQuery) -> OpQuery: ...
    def sort_by(self, key: ScalarStringQuery | CountQuery) -> OpQuery: ...
    def min_by(self, key: ScalarStringQuery | CountQuery) -> OpQuery: ...
    def max_by(self, key: ScalarStringQuery | CountQuery) -> OpQuery: ...
    def min_all_by(self, key: ScalarStringQuery | CountQuery) -> OpQuery: ...
    def max_all_by(self, key: ScalarStringQuery | CountQuery) -> OpQuery: ...
    def map_by(self, key: ScalarStringQuery, value: QueryExpr[_T]) -> MapQuery[_T]: ...
    def names(self) -> StringQuery: ...
    def string_attr(self, name: str) -> StringQuery: ...
    def attributes(self, name: str) -> AttributeQuery: ...
    def attr(self, name: str) -> StringQuery: ...
    def result_types(self) -> TypeQuery: ...
    def operand_types(self) -> TypeQuery: ...
    def union(self, other: Self) -> Self: ...
    def intersect(self, other: Self) -> Self: ...
    def difference(self, other: Self) -> Self: ...

class StringQuery(QueryExpr[list[str]]):
    def unique(self) -> Self: ...
    def reverse(self) -> Self: ...
    def count(self) -> CountQuery: ...
    def head(self, count: int) -> Self: ...
    def tail(self, count: int) -> Self: ...
    def union(self, other: Self) -> Self: ...
    def intersect(self, other: Self) -> Self: ...
    def difference(self, other: Self) -> Self: ...
    def sort(self) -> StringQuery: ...
    def min(self) -> StringQuery: ...
    def max(self) -> StringQuery: ...
    def min_all(self) -> StringQuery: ...
    def max_all(self) -> StringQuery: ...
    def one(self) -> ScalarStringQuery: ...
    def tally(self) -> MapQuery[int]: ...

class CountQuery(QueryExpr[int]): ...
class ScalarStringQuery(QueryExpr[str]): ...

class TypeQuery(QueryExpr[list[SemanticType]]):
    def unique(self) -> Self: ...
    def tally(self) -> MapQuery[object]: ...
    def reverse(self) -> Self: ...
    def count(self) -> CountQuery: ...
    def head(self, count: int) -> Self: ...
    def tail(self, count: int) -> Self: ...
    def spellings(self) -> StringQuery: ...

class AttributeQuery(QueryExpr[list[SemanticAttribute]]):
    def unique(self) -> Self: ...
    def tally(self) -> MapQuery[object]: ...
    def reverse(self) -> Self: ...
    def count(self) -> CountQuery: ...
    def head(self, count: int) -> Self: ...
    def tail(self, count: int) -> Self: ...
    def spellings(self) -> StringQuery: ...

class MapQuery(QueryExpr[dict[str, _T]]):
    def sort(self) -> Self: ...
    def sort_by_value(self) -> Self: ...
    def reverse(self) -> Self: ...
    def head(self, count: int) -> Self: ...
    def tail(self, count: int) -> Self: ...
    def head_expr(self, count: ReportExpr) -> Self: ...
    def tail_expr(self, count: ReportExpr) -> Self: ...
    def count(self) -> CountQuery: ...

def ops() -> OpQuery: ...
def input() -> OpQuery: ...
def op(name: str) -> Predicate: ...
def dialect(name: str) -> Predicate: ...
def has_attr(name: str) -> Predicate: ...
def result_type(spelling: str) -> Predicate: ...
def string_attr_eq(name: str, value: str) -> Predicate: ...
def always(value: bool) -> Predicate: ...
def changes() -> ChangeQuery: ...
def change_input() -> ChangeQuery: ...
def diff_op_input() -> DiffOpQuery: ...
def change(
    kind: Literal["added", "removed", "modified", "moved"],
) -> ChangePredicate: ...
def changed(
    field: Literal[
        "name",
        "operands",
        "result_types",
        "function_type",
        "attributes",
        "properties",
        "successors",
        "regions",
        "location",
        "position",
    ],
) -> ChangePredicate: ...

ReportValue: TypeAlias = (
    None
    | bool
    | int
    | float
    | str
    | SemanticOperation
    | SemanticValue
    | list[ReportValue]
    | dict[str, ReportValue]
)
ReportInput: TypeAlias = (
    ReportExpr
    | ReportQuery
    | StringQuery
    | ScalarStringQuery
    | CountQuery
    | bool
    | int
    | float
    | str
    | None
    | list[ReportInput]
    | dict[str, ReportInput]
)

class ReportQuery(QueryExpr[ReportValue]):
    def with_parameters(
        self, declarations: dict[str, Literal["int", "string", "bool"]]
    ) -> ReportQuery: ...

class ReportPattern:
    @staticmethod
    def name(name: str) -> ReportPattern: ...
    @staticmethod
    def wildcard() -> ReportPattern: ...
    @staticmethod
    def absent() -> ReportPattern: ...
    @staticmethod
    def present(pattern: ReportPattern) -> ReportPattern: ...
    @staticmethod
    def tuple(patterns: list[ReportPattern]) -> ReportPattern: ...
    @staticmethod
    def record(
        fields: dict[str, ReportPattern], *, ignore_rest: bool = False
    ) -> ReportPattern: ...
    @staticmethod
    def literal(value: bool | float | str) -> ReportPattern: ...
    def located(self, start: int, end: int) -> ReportPattern: ...
    def __bool__(self) -> Never: ...

class ReportMatchArm:
    def __init__(
        self,
        pattern: ReportPattern,
        value: ReportInput,
        *,
        guard: ReportInput | None = None,
    ) -> None: ...
    def __bool__(self) -> Never: ...

class ReportExpr:
    @staticmethod
    def tuple(values: list[ReportInput]) -> ReportExpr: ...
    @staticmethod
    def block(
        bindings: list[builtins.tuple[ReportPattern, ReportInput]], value: ReportInput
    ) -> ReportExpr: ...
    @staticmethod
    def conditional(
        condition: ReportInput, selected: ReportInput, otherwise: ReportInput
    ) -> ReportExpr: ...
    @staticmethod
    def value_match(subject: ReportInput, arms: list[ReportMatchArm]) -> ReportExpr: ...
    def __init__(self, value: ReportInput) -> None: ...
    @staticmethod
    def name(name: str) -> ReportExpr: ...
    @staticmethod
    def native(query: OpQuery | SsaQuery | CaptureQuery) -> ReportExpr: ...
    @staticmethod
    def comprehension(
        head: ReportInput, clauses: list[ReportGenerator]
    ) -> ReportExpr: ...
    @staticmethod
    def scope(bindings: dict[str, ReportInput], value: ReportInput) -> ReportExpr: ...
    def field(self, name: str) -> ReportExpr: ...
    def at(self, index: ReportInput) -> ReportExpr: ...
    def occurs(self) -> ReportExpr: ...
    def absent(self) -> ReportExpr: ...
    def lookup(self, key: ReportInput) -> ReportExpr: ...
    def has_key(self, key: ReportInput) -> ReportExpr: ...
    def default(self, fallback: ReportInput) -> ReportExpr: ...
    def contains(self, fragment: ReportInput) -> ReportExpr: ...
    def starts_with(self, prefix: ReportInput) -> ReportExpr: ...
    def ends_with(self, suffix: ReportInput) -> ReportExpr: ...
    def parse_int(self) -> ReportExpr: ...
    def parse_float(self) -> ReportExpr: ...
    def to_string(self) -> ReportExpr: ...
    def one(self) -> ReportExpr: ...
    def length(self) -> ReportExpr: ...
    def count(self) -> ReportExpr: ...
    def unique(self) -> ReportExpr: ...
    def tally(self) -> ReportExpr: ...
    def filter(self, pattern: ReportPattern, body: ReportInput) -> ReportExpr: ...
    def head(self, count: ReportInput) -> ReportExpr: ...
    def tail(self, count: ReportInput) -> ReportExpr: ...
    def reverse(self) -> ReportExpr: ...
    def check(
        self, operand: ReportInput | None = None, message: ReportInput | None = None
    ) -> ReportExpr: ...
    def sort(self, *, descending: bool = False) -> ReportExpr: ...
    def sort_by(self, field: str, *, descending: bool = False) -> ReportExpr: ...
    def sort_by_value(self, *, descending: bool = False) -> ReportExpr: ...
    def min(self) -> ReportExpr: ...
    def max(self) -> ReportExpr: ...
    def min_by(self, field: str) -> ReportExpr: ...
    def max_by(self, field: str) -> ReportExpr: ...
    def group_by(self, field: str) -> ReportExpr: ...
    def map(self, pattern: ReportPattern, body: ReportInput) -> ReportExpr: ...
    def flat_map(self, pattern: ReportPattern, body: ReportInput) -> ReportExpr: ...
    def windows(self, size: ReportInput) -> ReportExpr: ...
    def runs_by(self, field: str) -> ReportExpr: ...
    def with_fields(self, fields: dict[str, ReportInput]) -> ReportExpr: ...
    def align(self, after: ReportInput, field: str) -> ReportExpr: ...
    def sum(self) -> ReportExpr: ...
    def forall(self) -> ReportExpr: ...
    def exists(self) -> ReportExpr: ...
    def __bool__(self) -> Never: ...
    def __add__(self, other: ReportInput) -> ReportExpr: ...
    def __sub__(self, other: ReportInput) -> ReportExpr: ...
    def __mul__(self, other: ReportInput) -> ReportExpr: ...
    def __truediv__(self, other: ReportInput) -> ReportExpr: ...
    def __ge__(self, other: ReportInput) -> ReportExpr: ...
    def __gt__(self, other: ReportInput) -> ReportExpr: ...
    def __le__(self, other: ReportInput) -> ReportExpr: ...
    def __lt__(self, other: ReportInput) -> ReportExpr: ...
    def __and__(self, other: ReportInput) -> ReportExpr: ...
    def __or__(self, other: ReportInput) -> ReportExpr: ...
    def __invert__(self) -> ReportExpr: ...

class ReportGenerator:
    @staticmethod
    def in_values(
        name: str, source: ReportInput, filter: ReportInput | None = None
    ) -> ReportGenerator: ...
    @staticmethod
    def in_pattern(
        pattern: ReportPattern,
        source: ReportInput,
        filter: ReportInput | None = None,
        *,
        case: bool = False,
    ) -> ReportGenerator: ...
    @staticmethod
    def bind(name: str, value: ReportInput) -> ReportGenerator: ...

def bound_ops(name: str) -> OpQuery: ...
def report(value: ReportInput) -> ReportQuery: ...
def require(condition: ReportInput, value: ReportInput, message: str) -> ReportExpr: ...
def op_expr(name: ReportInput) -> Predicate: ...

class SsaQuery(QueryExpr[SemanticValue]): ...

class CaptureQuery(
    QueryExpr[
        list[dict[str, SemanticOperation | SemanticValue | list[SemanticOperation]]]
    ]
):
    def with_parameters(
        self, declarations: dict[str, Literal["int", "string", "bool"]]
    ) -> CaptureQuery: ...
    def project(self, subject: str, fields: dict[str, ReportInput]) -> ReportQuery: ...

class MatchPredicate:
    def __and__(self, other: MatchPredicate) -> MatchPredicate: ...
    def __or__(self, other: MatchPredicate) -> MatchPredicate: ...
    def __invert__(self) -> MatchPredicate: ...
    def __bool__(self) -> Never: ...

class MatchBuilder:
    def from_(self, name: str, source: OpQuery) -> MatchBuilder: ...
    def bind(self, name: str, value: SsaQuery) -> MatchBuilder: ...
    def where_(self, predicate: MatchPredicate) -> MatchBuilder: ...
    def build(self) -> CaptureQuery: ...

def matches() -> MatchBuilder: ...
def bound_ssa(name: str) -> SsaQuery: ...
def capture_ops(subject: str, field: str) -> OpQuery: ...
def capture_ssa(subject: str, field: str) -> SsaQuery: ...
def same_value(left: SsaQuery, right: SsaQuery) -> MatchPredicate: ...
