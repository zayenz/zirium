let chosen = {k: {n mod 3 for n in 1..5}
              for w in ["pear", "apple"]
              for k in [w, w ++ "!"] if ends_with(k, "!")};
report {"set": {3, 1, 3}, "dictionary": chosen, "access": chosen["pear!"],
        "empty": {}, "typed": [set<int>(), set<bool>(), set<float>()],
        "sorted": sort({3, 1, 3})};
