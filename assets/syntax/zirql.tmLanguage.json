{
  "name": "zirql",
  "scopeName": "source.zirql",
  "patterns": [
    {
      "name": "comment.line.number-sign.zirql",
      "match": "[#%].*$"
    },
    {
      "name": "comment.block.zirql",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "entity.name.quoted.zirql",
      "begin": "'",
      "end": "'"
    },
    {
      "name": "string.quoted.double.zirql",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.zirql",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.zirql",
      "match": "(?<![\\w.])\\b(?:let|param|report|fn|if|then|elseif|else|endif|for|in|match|from|bind|where|case|with|loop|break|continue)\\b(?!\\s*:)"
    },
    {
      "name": "keyword.operator.word.zirql",
      "match": "(?<![\\w.])\\b(?:and|or|not|div|mod|default)\\b(?!\\s*:)"
    },
    {
      "name": "constant.language.zirql",
      "match": "(?<![\\w.])\\b(?:true|false|null)\\b(?!\\s*:)|<>"
    },
    {
      "name": "storage.type.zirql",
      "match": "(?<![\\w.])\\b(?:bool|int|float|string|opt|sequence|tuple|record|set|keyed|queue|identity_set)\\b(?!\\s*:)"
    },
    {
      "name": "constant.numeric.zirql",
      "match": "\\b(?:0[xX][0-9A-Fa-f]+|0o[0-7]+|[0-9]+(?:\\.(?!\\.)[0-9]*)?(?:[eE][+-]?[0-9]+)?)\\b"
    },
    {
      "name": "entity.name.function.zirql",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "constant.language.zirql",
      "match": "(?<![\\w.])\\b(?:absent|present)\\b(?!\\s*:)"
    },
    {
      "name": "support.function.zirql",
      "match": "(?<![\\w.])\\b(?:input|count)\\b(?!\\s*:)"
    },
    {
      "name": "keyword.operator.zirql",
      "match": "\\/\\\\|\\\\/|=>|->|\\.\\.|\\+\\+|<=|>=|==|!=|[|+*/<>=-]"
    }
  ]
}
